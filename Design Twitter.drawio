  <diagram name="Page-1" id="3TfGIvR1jOIAHOzqCSD1">
    <mxGraphModel dx="1001" dy="513" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="W1eGZ3S9uEBxySaymrxa-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Design Twitter System&lt;/h1&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="40" width="430" x="210" y="60" as="geometry" />
        </mxCell>
        <mxCell id="UQ3sa2eTAy_rHA3YkZMz-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Functional Requirements&lt;/h1&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="370" x="210" y="150" as="geometry" />
        </mxCell>
        <mxCell id="UQ3sa2eTAy_rHA3YkZMz-2" parent="1" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" value="&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Users should be able to add tweets&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Users should be able to follow/unfollowe other users&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font size=&quot;3&quot;&gt;Users should be able to get the tweets shared by their followees in their feed&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;Additionals:&lt;br&gt;1. Users can like/comment to tweets posted by others&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot;&gt;2. User can create a tweet to restricted users(close friends)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="590" x="100" y="200" as="geometry" />
        </mxCell>
        <mxCell id="UQ3sa2eTAy_rHA3YkZMz-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Non Functional Requirements&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;1. &lt;/font&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;System should be available always for reading and posting the tweets.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;2. The system should be consistent with the tweets shared by people, availability&amp;gt;&amp;gt;consistency&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;3. The system should support 500M users and 200M + DAU.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;4. The tweet. creation and posting should be less than 500 ms delay.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;5. Tolerance to partition, even if any one instance is running, but its connectivity is failed over the network layer, using the rest of the instances the system should work&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;Additionals:&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;1. Security, authentication and authorization of users should be handled safely and user data has to be saved encrypted form..&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;2. Data archival and storage can be considered to store the older tweets.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="405" width="620" x="120" y="465" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
